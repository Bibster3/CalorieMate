{
  "homepage": "https://bibster3.github.io/CalorieMate/",
  "name": "caloriemate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --ext ts,tsx --max-warnings 0",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "predeploy": "npm run build",
    "deploy": "node ./node_modules/gh-pages/bin/gh-pages.js -d dist",
    "test": "rm -rf .tmp-test && node ./node_modules/typescript/bin/tsc --module commonjs --target ES2020 --outDir .tmp-test src/shared/types.ts src/shared/functions.ts src/shared/functions.test.ts && printf '{\"type\":\"commonjs\"}' > .tmp-test/package.json && node .tmp-test/functions.test.js"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "lucide-react": "^0.503.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-gauge-chart": "^0.5.1",
    "react-router-dom": "^6.21.1",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fake-indexeddb": "^5.0.2",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^6.3.2"
  }
}
